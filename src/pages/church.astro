---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { GATHERING } from "../consts";
---

<Layout
	title="Sunday Church Service | Christian Discipleship in San Francisco"
	description="Join Acts College SF for Christian Discipleship every Sunday at 12:00 PM at The Collective Studios, 1751 Fulton St, San Francisco. Christian fellowship for college students."
	keywords="Klesis SF church, Sunday service San Francisco, Christian discipleship San Francisco, Christian church USF, Christian church SFSU, college church SF, Acts College SF church, Christian fellowship Sunday service, college ministry church"
>
	<section class="hero">
		<img
			src="/header-banners/unsplash-image-OD9EOzfSOh0.webp"
			alt="Church Service"
			class="hero-image"
		/>
		<div class="hero-overlay"></div>
		<div class="container">
			<h1>Church Service</h1>
			<p class="hero-subtitle">Join us for our Sunday services!</p>
		</div>
	</section>

	<section class="about-church-section">
		<div class="container">
			<h2>Sunday Service Information</h2>
			<div class="map-card-container">
				<div class="map-card">
					<div class="map-card-content">
						<div class="service-details">
							<div class="detail-item">
								<span class="detail-label">Location</span>
								<span class="detail-value">{GATHERING.venue}</span>
							</div>
							<div class="detail-item">
								<span class="detail-label">Start Time</span>
								<span class="detail-value"
									>Sundays @ {GATHERING.time}</span
								>
							</div>
							<div class="detail-item">
								<span class="detail-label">Address</span>
								<span class="detail-value"
									>{GATHERING.street}<br />{GATHERING.city}, {
										GATHERING.region
									} {GATHERING.postalCode}</span
								>
							</div>
						</div>
						<div class="map-embed">
							<iframe
								src={GATHERING.mapEmbedUrl}
								title={`Map of ${GATHERING.venue}`}
								allowfullscreen=""
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								style="border:0; min-width: 300px;"
							>
							</iframe>
						</div>
					</div>
				</div>
			</div>

		<div class="belief-content">
			<p>
				Koinonia SFSU and Klesis SF meet together for {GATHERING.name} every
				Sunday at {GATHERING.time}. As a Christian club and fellowship serving
				college students in San Francisco, we gather as one community to
				worship, learn from God's Word, and fellowship together.
			</p>

			<p>
				{GATHERING.format}
			</p>

			<p>
				If you have a question, or you'd just like to let us know you're
				coming, email us at <a href="mailto:actcollegesf@gmail.com"
					>actcollegesf@gmail.com</a
				> and we'll be glad to help.
			</p>
		</div>
		</div>
	</section>

	<section class="join-section">
		<div class="container">
			<h2>Ready to Join Us?</h2>
			<p class="join-text">
				We'd love to have you join us for our next service.
			</p>
			<div class="join-actions">
				<Button href="/connect" variant="primary">Get Connected</Button>
				<Button href="/statement-of-faith" variant="outline"
					>Our Beliefs</Button
				>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Base Styles */
	.container {
		max-width: var(--container-max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-sm);
	}

	/* Common Section Styles */
	h2 {
		font-size: 2.5rem;
		color: var(--color-text);
		margin-bottom: var(--spacing-lg);
		text-align: center;
	}

	/* Hero Section */
	.hero {
		position: relative;
		color: white;
		padding: var(--spacing-xl) 0;
		text-align: center;
		overflow: hidden;
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			to bottom,
			rgba(15, 23, 42, 0.4),
			rgba(15, 23, 42, 0.8)
		);
		backdrop-filter: blur(2px);
		z-index: -1;
	}

	.hero h1 {
		font-size: clamp(3rem, 6vw, 4.5rem);
		font-weight: 800;
		margin-bottom: var(--spacing-sm);
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
		color: white;
	}

	.hero-subtitle {
		font-size: clamp(1.25rem, 3vw, 1.5rem);
		line-height: 1.6;
		opacity: 0.95;
		max-width: 700px;
		margin: 0 auto;
		font-weight: 500;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
	}

	/* Map Card Styles */
	.map-card-container {
		display: flex;
		justify-content: center;
		margin: 0 auto var(--spacing-md) auto;
		max-width: 600px;
		width: 100%;
	}

	.map-card {
		background: var(--color-bg);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--color-border);
		overflow: hidden;
		width: 100%;
		transition: var(--transition);
	}

	.map-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-xl);
	}

	.map-card-content {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.service-details {
		padding: var(--spacing-md);
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-alt);
	}

	.detail-item {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding: var(--spacing-xs) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.detail-item:last-child {
		border-bottom: none;
	}

	.detail-label {
		font-weight: 600;
		color: var(--color-text);
		font-size: 1rem;
		font-family: var(--font-heading);
	}

	.detail-value {
		color: var(--color-text-light);
		font-size: 1rem;
		text-align: right;
	}

	.detail-value a {
		color: var(--color-primary);
		font-weight: 500;
	}

	.detail-value a:hover {
		text-decoration: underline;
	}

	.map-embed {
		position: relative;
		padding-top: 56.25%; /* 16:9 aspect ratio */
		height: 0;
		overflow: hidden;
		flex-grow: 1;
	}

	.map-embed iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
		background: var(--color-bg-alt);
	}

	/* Section Specific Styles */
	.about-church-section {
		padding: var(--spacing-xl) 0;
		background: var(--color-bg);
	}

	.belief-content p {
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--color-text-light);
		max-width: 800px;
		margin: 0 auto var(--spacing-md);
		text-align: center;
	}

	.belief-content a {
		color: var(--color-primary);
		font-weight: 600;
	}

	.join-section {
		padding: var(--spacing-xl) 0;
		background: var(--color-bg);
		text-align: center;
	}

	.join-text {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 600px;
		margin: 0 auto var(--spacing-lg);
		line-height: 1.7;
	}

	.join-actions {
		display: flex;
		gap: var(--spacing-sm);
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Mobile Styles */
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.detail-item {
			flex-direction: column;
			gap: 0.25rem;
		}

		.detail-value {
			text-align: left;
		}
	}
</style>
